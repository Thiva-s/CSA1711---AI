# AI College Assistant - Environment Variables
# Copy this file to .env and fill in your values

# LLM Provider Configuration
# Supported providers: Groq, OpenAI
LLM_PROVIDER = Groq

# API Keys (NEVER commit actual keys to Git!)
# Get your Groq API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Get your OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Model Selection (optional - defaults will be used if not specified)
# Groq models: llama-3.1-8b-instant, llama-3.3-70b-versatile, openai/gpt-oss-120b, qwen/qwen3.6-27b
# OpenAI models: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
LLM_MODEL = llama-3.1-8b-instant

# RAG Configuration (optional - defaults shown)
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
MAX_CRAWL_DEPTH=2
MAX_PAGES=50
REQUEST_TIMEOUT=10

# AI Settings (optional)
TEMPERATURE=0.1
MAX_TOKENS=1024
STREAMING=true

# Vector Database Path (optional)
VECTOR_DB_PATH=./vectorstore

# Data Directory (optional)
DATA_DIR=./data/scraped
